#!/usr/bin/env bash
# `run` -- the one launcher both smoke legs use.
#
# WHY THIS IS NOT JUST `exec "$@"`
#   All three ways a staged Windows binary fails to start are SILENT, and two of
#   them are indistinguishable from each other by exit code alone. Measured on a
#   real Windows 11 (26200) box and on wine 11.0, against logos-package's staged
#   lgx.exe with exactly one DLL removed from an otherwise-working tree:
#
#   launcher                intact     missing DLL                      missing path
#   ----------------------  ---------  -------------------------------  -----------------
#   Windows, non-bash       rc=0       rc=-1073741515 (0xC0000135),     n/a
#     parent (PowerShell)              stdout AND stderr both EMPTY
#   Windows, Git-Bash/MSYS  rc=0       rc=127, stdout empty, stderr     rc=127, "No such
#     parent (the CI leg)              names A dependency -- NOT        file or directory"
#                                      reliably the missing one
#   wine on Linux           rc=0       rc=53 (0xC0000135 & 0xFF),       rc=53 + "wine:
#                                      stdout AND stderr both EMPTY     failed to open"
#
#   THE MSYS COLUMN, MEASURED RATHER THAN ASSUMED
#     An earlier revision of this comment said the MSYS line names
#     "libgcc_s_seh-1.dll every time, whichever DLL was actually removed".
#     That is false. Measured on Windows 11 (26200), MSYS bash 5.3.15, against
#     a real cross-built lgpm.exe + its 26 shipped DLLs, removing each DLL in
#     turn from an otherwise-working tree:
#
#       9 of 26 removals broke the load (rc=127, stdout empty).
#         7 of those 9 named `api-ms-win-crt-string-l1-1-0.dll` -- a Windows
#           API-set DLL that is present and was never touched. (liblgx.dll,
#           libsodium-26.dll, libstdc++-6.dll, zlib1.dll, icuuc76.dll,
#           icudt76.dll, libmcfgthread-2.dll all produce that same line.)
#         2 of those 9 named the DLL actually removed (libgcc_s_seh-1.dll,
#           libpackage_manager_lib.dll) -- which is presumably where the
#           "libgcc every time" belief came from: one sample, generalised.
#       17 of 26 removals did not break the load at all (rc=0, full output):
#         they are not on the --help path's load-time closure.
#
#     So the useful, true statement is narrow: the name in that stderr line is
#     EVIDENCE THAT THIS IS A LOADER FAILURE, and is NOT the identity of the
#     missing dependency. This file uses it only for the former.
#
#   So under bash, 127 means EITHER "the path is wrong" OR "a DLL is missing",
#   and under wine 53 means either and prints nothing at all. The pre-flight
#   existence check separates the two; the exit-code case names the other one.
#
# EVERY DIAGNOSTIC THIS SCRIPT EMITS GOES TO STDERR.
#   Not cosmetic. The documented smoke idiom pipes this wrapper --
#   `run lgx/bin/lgx.exe --help | grep -qi usage` -- and a diagnosis written to
#   stdout is swallowed by the consumer. Measured with this script and a 127
#   loader failure: run alone printed the full eight-line story; the same
#   failure through `| grep -qi usage` reached the log as ONE raw MSYS line and
#   nothing else. GitHub parses `::error::` on stderr as well as stdout, so this
#   costs nothing and makes the wrapper's whole reason for existing survive a
#   pipe. The PROGRAM's own stdout stays on stdout, so `| grep` still works.
#
# CONTRACT
#   Paths are relative to the staged tree ROOT, which holds one directory per
#   target: `run lgx/bin/lgx.exe --help`, never `run bin/lgx.exe --help`.
#   $RUN_EXEC, if set, is prepended (the wine binary). `run -q CMD` permits a
#   command that legitimately produces no output.
set -uo pipefail

# All ::error:: output goes to stderr. See above.
err() { while [ "$#" -gt 0 ]; do printf '::error::%s\n' "$1" >&2; shift; done; }

RUN_ALLOW_SILENT="${RUN_ALLOW_SILENT:-}"
if [ "${1:-}" = "-q" ]; then RUN_ALLOW_SILENT=1; shift; fi

pe="${1:-}"
[ -n "$pe" ] || { err "run: no program given"; exit 1; }

if [ ! -f "$pe" ]; then
  err "run: '$pe' does not exist (cwd: $(pwd))." \
      "Smoke paths are relative to the staged tree ROOT, and the root holds" \
      "one directory PER TARGET -- so a path starts with the target name:" \
      "    run lgx/bin/lgx.exe --help      not    run bin/lgx.exe --help" \
      "staged targets here: $(find . -mindepth 1 -maxdepth 1 -type d \
                                | sed 's|^\./||' | sort | tr '\n' ' ')"
  exit 1
fi

# Captured rather than streamed: the EMPTINESS of stdout is itself the signal
# for two of the failure modes above. These are short-lived CLIs, so paying for
# that with a loss of interleaving is the right trade.
o=$(mktemp); e=$(mktemp)
if [ -n "${RUN_EXEC:-}" ]; then
  "$RUN_EXEC" "$@" >"$o" 2>"$e"
else
  "$@" >"$o" 2>"$e"
fi
rc=$?
cat "$o"; cat "$e" >&2
osz=$(wc -c < "$o"); esz=$(wc -c < "$e")
# $e outlives the echo: the CONTENT of stderr, not just its size, is what
# separates a loader failure from a program that failed and said why.
rm -f "$o"

# 53 and 127 only. bash masks a child's status to 0-255, so the raw Windows
# spellings 3221225781 and -1073741515 CANNOT appear in $? -- they were listed
# here and were dead branches. Both are 0xC0000135, and 0xC0000135 & 0xFF = 0x35
# = 53, which is the wine leg's number; 127 is what an MSYS parent reports.
#
# Emptiness of stdout alone is NOT enough to call it a loader failure. A program
# is entitled to exit 53 or 127 and explain itself on stderr, and answering that
# with eight lines about STATUS_DLL_NOT_FOUND is a confident wrong diagnosis
# aimed at the next person to read this log. So corroborate: a real 0xC0000135
# says nothing at all (wine) or names a DLL (MSYS).
case "$rc" in
  53|127)
    if [ "$osz" -eq 0 ]; then
      loaderish=0
      if [ "$esz" -eq 0 ]; then
        loaderish=1                     # wine: silent on both streams
      elif grep -qiE '\.dll|loading shared libraries|cannot open shared object' "$e"; then
        loaderish=1                     # MSYS: names A dependency (not necessarily the right one)
      fi

      # -q CHANGES WHAT THE SILENCE MEANS, so it has to be consulted HERE and
      # not only in the exit-0 branch below. The whole loader diagnosis rests on
      # "stdout was empty and that is abnormal". For a command the caller has
      # declared legitimately silent, empty stdout is normal and therefore
      # evidence of nothing -- so asserting STATUS_DLL_NOT_FOUND at the next
      # reader would be the same confident-wrong-answer this file elsewhere
      # refuses to give. Report the failure; do not claim to know its cause.
      if [ "$loaderish" -eq 1 ] && [ -n "$RUN_ALLOW_SILENT" ]; then
        err "$pe exited $rc." \
            "It was invoked with -q, i.e. the caller declared this command legitimately" \
            "silent, so its empty stdout is NOT evidence of anything and this is NOT" \
            "diagnosed as a missing DLL. It may still be one: re-run this command" \
            "WITHOUT -q, where silence becomes meaningful again." \
            "Shipped beside it:"
        # shellcheck disable=SC2012  # these are DLL names, not arbitrary input
        ls -1 "$(dirname "$pe")" | sed 's/^/::error::  /' >&2
        rm -f "$e"
        exit "$rc"
      fi

      if [ "$loaderish" -eq 1 ]; then
        err "$pe exited $rc having printed nothing on stdout." \
            "That is STATUS_DLL_NOT_FOUND (0xC0000135): the loader could not find a" \
            "dependency, so the process died before main() and never got to say so." \
            "Do NOT read the DLL named in the 'error while loading shared libraries'" \
            "line above as the missing one. Measured on Windows 11 against a real" \
            "lgpm.exe + 26 DLLs, removing each in turn: of the 9 removals that broke" \
            "the load, 7 named api-ms-win-crt-string-l1-1-0.dll -- a system DLL that" \
            "was present the whole time -- and only 2 named the DLL actually removed." \
            "The name tells you THAT this is a loader failure, not WHICH file is gone." \
            "The import-closure gate should have caught this on the builder; if it" \
            "did not, either the artifact lost a file in transit or the DLL is" \
            "loaded at RUNTIME (LoadLibrary), which no import table records." \
            "Shipped beside it:"
        # shellcheck disable=SC2012  # these are DLL names, not arbitrary input
        ls -1 "$(dirname "$pe")" | sed 's/^/::error::  /' >&2
        rm -f "$e"
        exit 1
      fi
      if grep -qi '^wine:' "$e"; then
        err "$pe exited $rc: wine itself refused to launch it (message above)." \
            "A launch failure, but NOT the silent 0xC0000135 shape -- that one" \
            "prints nothing at all under wine."
      else
        err "$pe exited $rc with no stdout, but its stderr above is not a" \
            "loader failure -- it names no DLL, and a real 0xC0000135 either says" \
            "nothing at all (wine) or names a dependency (MSYS). Read it as the" \
            "program's own failure; this is NOT diagnosed as a missing DLL."
      fi
      rm -f "$e"
      exit "$rc"
    fi ;;
esac
rm -f "$e"

if [ "$rc" -eq 0 ] && [ "$osz" -eq 0 ] && [ "$esz" -eq 0 ] && [ -z "$RUN_ALLOW_SILENT" ]; then
  err "$pe exited 0 and printed nothing at all." \
      "Silent success is this project's dominant defect class -- an install rule" \
      "that copied nothing, a package that labelled itself linux-amd64, a plugin" \
      "shipped without its DLLs, a reply never sent. Every one of them exited 0." \
      "A smoke test that cannot tell 'it worked' from 'it did nothing' is not" \
      "coverage." \
      "If this command is legitimately silent, invoke it as: run -q $pe ..."
  exit 1
fi

exit "$rc"
